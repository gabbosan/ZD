<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cálculo Estorno x Cupom</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,sans-serif;
    background:#f4f4f4;
    padding:20px;
}

.container{
    max-width:700px;
    margin:auto;
    background:#fff;
    border-radius:10px;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
    overflow:hidden;
}

.banner{
    background:#A8C1C6;
    text-align:center;
    padding:30px 20px;
}

.banner h1{
    color:#003B75;
    font-size:clamp(36px,6vw,60px);
}

.banner h2{
    color:#003B75;
    font-size:clamp(18px,3vw,28px);
}

.formulario{
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.linha{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:#E7EEF0;
    border-radius:8px;
    padding:15px;
}

.linha label{
    font-size:18px;
    font-weight:bold;
    color:#003B75;
}

.entrada{
    display:flex;
    align-items:center;
    gap:5px;
}

.entrada span{
    font-weight:bold;
}

.entrada input{
    border:none;
    background:transparent;
    outline:none;
    text-align:right;
    font-size:20px;
    font-weight:bold;
    width:120px;
}

.resultado span{
    font-size:20px;
    font-weight:bold;
   
}

@media(max-width:600px){

    .linha{
        flex-direction:column;
        gap:10px;
        text-align:center;
    }

    .entrada{
        justify-content:center;
    }

}

</style>
</head>
<body>

<div class="container">

    <div class="banner">
        <h1>CÁLCULO</h1>
        <h2>ESTORNO x CUPOM</h2>
    </div>

    <div class="formulario">

        <div class="linha">
            <label>Ticket</label>
            <div class="entrada">
                <span>R$</span>
                <input id="ticket"
                       value="0,00"
                       oninput="formatarMoeda(this);calcular();">
            </div>
        </div>

        <div class="linha">
            <label>Cupom</label>
            <div class="entrada">
                <span>R$</span>
                <input id="cupom"
                       value="0,00"
                       oninput="formatarMoeda(this);calcular();">
            </div>
        </div>

        <div class="linha">
            <label>Prejuízo</label>
            <div class="entrada">
                <span>R$</span>
                <input id="prejuizo"
                       value="0,00"
                       oninput="formatarMoeda(this);calcular();">
            </div>
        </div>

        <div class="linha resultado">
            <label>Investimento</label>
            <span id="investimento">R$ 0,00</span>
        </div>

        <div class="linha resultado">
            <label>Estorno</label>
            <span id="estorno">R$ 0,00</span>
        </div>

        <div class="linha resultado">
            <label>CupomCX</label>
            <span id="cupomcx">—</span>
        </div>

    </div>

</div>

<script>

function ajustarLargura(input){
    input.style.width = Math.max(input.value.length,4) + 'ch';
}

function formatarMoeda(input){

    let valor = input.value.replace(/\D/g,'');

    if(valor === ''){
        valor = '0';
    }

    valor = (parseInt(valor,10)/100).toLocaleString(
        'pt-BR',
        {
            minimumFractionDigits:2,
            maximumFractionDigits:2
        }
    );

    input.value = valor;
    ajustarLargura(input);
}

function moedaParaNumero(valor){

    return parseFloat(
        valor
            .replace(/\./g,'')
            .replace(',','.')
    ) || 0;

}

function moeda(valor){

    return valor.toLocaleString(
        'pt-BR',
        {
            minimumFractionDigits:2,
            maximumFractionDigits:2
        }
    );

}

function calcular(){

    let ticket = moedaParaNumero(
        document.getElementById('ticket').value
    );

    let cupom = moedaParaNumero(
        document.getElementById('cupom').value
    );

    let prejuizo = moedaParaNumero(
        document.getElementById('prejuizo').value
    );

    if(prejuizo > ticket){

        prejuizo = ticket;

        document.getElementById('prejuizo').value =
            moeda(ticket);

        ajustarLargura(
            document.getElementById('prejuizo')
        );
    }

    let investimento = ticket - cupom;

    let estorno;
    let cupomcx = null;

    if(prejuizo > investimento){

        estorno = investimento;

        let diferenca =
            prejuizo - investimento;

        cupomcx =
            Math.ceil(diferenca / 5) * 5;

    }else{

        estorno = prejuizo;

    }

    document.getElementById('investimento').textContent =
        'R$ ' + moeda(investimento);

    document.getElementById('estorno').textContent =
        'R$ ' + moeda(estorno);

    document.getElementById('cupomcx').textContent =
        cupomcx === null
            ? '—'
            : 'R$ ' + moeda(cupomcx);
}

window.onload = function(){

    ['ticket','cupom','prejuizo'].forEach(id => {

        const campo =
            document.getElementById(id);

        formatarMoeda(campo);

    });

    calcular();

};

</script>

</body>
</html>
